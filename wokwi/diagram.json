    [ "esp:5", "readyResistor:1", "green", [ "h0" ] ],
    [ "readyResistor:2", "readyLed:A", "green", [ "h0" ] ],
    [ "readyLed:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:6", "buzzer:2", "purple", [ "h0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:7", "button:1.l", "blue", [ "h0" ] ],
    [ "button:2.l", "esp:GND.1", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
