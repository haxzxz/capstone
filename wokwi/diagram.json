{
  "version": 1,
  "author": "School Zone Safety Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "alertLed", "top": -65, "left": 270, "attrs": { "color": "red", "label": "ALERT" } },
    { "type": "wokwi-led", "id": "readyLed", "top": 15, "left": 270, "attrs": { "color": "green", "label": "READY" } },
    { "type": "wokwi-resistor", "id": "alertResistor", "top": -65, "left": 190, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "readyResistor", "top": 15, "left": 190, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 105, "left": 270, "attrs": { "volume": "0.3" } },
    { "type": "wokwi-pushbutton", "id": "button", "top": 190, "left": 265, "attrs": { "color": "blue", "label": "TEST ALERT", "key": "A", "bounce": "0" } }
  ],
  "connections": [
    [ "esp:4", "alertResistor:1", "red", [ "h0" ] ],
    [ "alertResistor:2", "alertLed:A", "red", [ "h0" ] ],
